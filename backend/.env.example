# Chatterbox model to load: english | multilingual | turbo | nano
#   english      - ChatterboxTTS (500M, built-in default voice, exaggeration + CFG)
#   multilingual - ChatterboxMultilingualTTS (23+ languages, V3 default)
#   turbo        - ChatterboxTurbo (350M, English, low latency, needs reference audio)
#   nano         - ChatterboxNano (110M, English, CPU-friendly, needs reference audio)
CB_MODEL=english

# Device: auto | cuda | cpu |mps  (auto = cuda > mps > cpu)
CB_DEVICE=auto

# Multilingual checkpoint: v2 | v3
CB_MTL_T3=v3

# Load the model at startup (1) or lazily on first generation (0)
CB_EAGER_LOAD=0

# Public URL of this backend, used by the frontend build (informational)
# CB_PUBLIC_URL=https://your-backend.up.railway.app

# Where generated audio + cloned voices live (keep on a persistent volume in prod)
CB_DATA_DIR=./data

# Generation limits
CB_MAX_TEXT=6000
CB_CHUNK_MAX_CHARS=420
CB_MAX_CONCURRENT=1
# Max queued+processing jobs before /api/generate returns 429
CB_MAX_QUEUE=25
CB_MIN_REF_SECONDS=5.5
CB_MAX_REF_SECONDS=30

# CORS: comma separated origins, or * for development
CB_CORS_ORIGINS=*

# Optional HF token for gated checkpoints
# HF_TOKEN=
