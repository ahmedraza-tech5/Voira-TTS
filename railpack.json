{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "packages": {
    "python": "3.12"
  },
  "buildAptPackages": ["git", "ffmpeg", "libsndfile1"],
  "steps": {
    "install": {
      "commands": [
        "cd backend && pip install --no-cache-dir -r requirements.txt",
        "pip install --no-cache-dir 'resemble-perth @ git+https://github.com/resemble-ai/Perth.git@master'",
        "pip install --no-cache-dir -e ./chatterbox"
      ]
    }
  },
  "deploy": {
    "startCommand": "cd backend && uvicorn app.main:app --host 0.0.0.0 --port $PORT --workers 1",
    "variables": {
      "CB_DATA_DIR": "/data",
      "CB_EAGER_LOAD": "1"
    }
  }
}