{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "rootDirectory": "backend"
  },
  "deploy": {
    "startCommand": "bash start.sh",
    "healthcheckPath": "/api/voices",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}